# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : utilisée uniquement côté serveur (tâche planifiée + webhook Stripe)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=re_...
# Adresse d'expédition sur un domaine vérifié dans Resend
RESEND_FROM_EMAIL=relances@votre-domaine.fr

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiant du prix récurrent à 19 €/mois
STRIPE_PRICE_ID=price_...

# --- Tâche planifiée : chaîne aléatoire longue (Vercel l'envoie automatiquement) ---
CRON_SECRET=changez-moi-par-une-chaine-aleatoire
